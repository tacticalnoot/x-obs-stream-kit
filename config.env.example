# ============================================
# X Live Stream Kit — Configuration
# ============================================
# Copy this file to config.env and fill in your values.
# NEVER commit config.env — it's gitignored.
# ============================================

# ---- X Media Studio RTMP ----
# Get these from: https://studio.x.com/producer → Sources → your RTMP source
RTMP_URL=rtmps://
STREAM_KEY=

# ---- Game Settings ----
# Used for reference/documentation only — OBS game capture is set manually
GAME_NAME=RuneScape: Dragonwilds
GAME_PROCESS=

# ---- OBS Output ----
VIDEO_BITRATE=9000
AUDIO_BITRATE=128
OUTPUT_RESOLUTION=1280x720
FPS=60
KEYFRAME_INTERVAL=3

# ---- Stream Info ----
STREAM_TITLE=
STREAM_CATEGORY=Gaming

# ---- Fallback / Compatibility ----
# Add -dx11 to Steam launch options if DX12 causes capture issues
# STEAM_LAUNCH_OPTIONS=-dx11
